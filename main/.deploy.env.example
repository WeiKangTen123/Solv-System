# Where `npm run deploy` sends this. Copy to main/.deploy.env, which is
# gitignored — the repository is public, and the address of your server is not
# something to publish. docs/RUNBOOK.md has what the box needs first.

# Reaching the box — set ONE of these two.
# DEPLOY_SSH=weika@203.0.113.9
# DEPLOY_INSTANCE=xero-automation
# DEPLOY_ZONE=us-central1-a               only with DEPLOY_INSTANCE

# Where the checkout lives on the box, and who owns it.
DEPLOY_PATH=/home/weika/solv-system
DEPLOY_USER=weika

# The URL the deploy asks whether the RUNNING process is on the shipped commit.
# Without it a deploy cannot tell a restart that happened from one that did not.
# DEPLOY_HEALTH=https://your-host/dashboard/health

# Rarely changed.
# DEPLOY_BRANCH=main
# DEPLOY_PM2_APP=solv-expense
